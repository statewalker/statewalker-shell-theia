{
  "name": "@theia-shell/p7-embedpdf",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-shell-theia.git",
    "directory": "protos/p7-embedpdf"
  },
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-shell-theia/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-shell-theia/tree/main/protos/p7-embedpdf#readme",
  "private": true,
  "theia": {
    "target": "browser-only",
    "frontend": {
      "config": {
        "applicationName": "P7 EmbedPDF",
        "preferences": {
          "security.workspace.trust.enabled": false
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter @theia-shell/theia-files-api --filter @theia-shell/theia-pdf-viewer build && theia build --mode development",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@theia-shell/p7-extension": "workspace:^",
    "@theia-shell/theia-files-api": "workspace:^",
    "@theia-shell/theia-pdf-viewer": "workspace:^",
    "@theia/core": "catalog:",
    "@theia/editor": "catalog:",
    "@theia/filesystem": "catalog:",
    "@theia/messages": "catalog:",
    "@theia/monaco": "catalog:",
    "@theia/navigator": "catalog:",
    "@theia/preferences": "catalog:",
    "@theia/workspace": "catalog:"
  },
  "devDependencies": {
    "@theia/cli": "catalog:"
  }
}
