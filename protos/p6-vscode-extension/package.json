{
  "name": "@theia-shell/p6-vscode-extension",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-shell-theia.git",
    "directory": "protos/p6-vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-shell-theia/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-shell-theia/tree/main/protos/p6-vscode-extension#readme",
  "private": true,
  "theia": {
    "target": "browser-only",
    "frontend": {
      "config": {
        "applicationName": "P6 VS Code web extension",
        "preferences": {
          "security.workspace.trust.enabled": false
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter @theia-shell/p6-extension build && theia build --mode development && node scripts/prepare-late-plugins.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@theia-shell/p3-extension": "workspace:^",
    "@theia-shell/p6-extension": "workspace:^",
    "@theia-shell/theia-files-api": "workspace:^",
    "@theia/core": "catalog:",
    "@theia/editor": "catalog:",
    "@theia/filesystem": "catalog:",
    "@theia/messages": "catalog:",
    "@theia/monaco": "catalog:",
    "@theia/navigator": "catalog:",
    "@theia/plugin-ext": "catalog:",
    "@theia/plugin-ext-vscode": "catalog:",
    "@theia/preferences": "catalog:",
    "@theia/workspace": "catalog:"
  },
  "devDependencies": {
    "@theia/cli": "catalog:",
    "@theia/application-manager": "catalog:"
  },
  "theiaPluginsDir": "plugins-src"
}
