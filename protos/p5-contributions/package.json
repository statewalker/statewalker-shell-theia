{
  "name": "@theia-shell/p5-contributions",
  "version": "0.0.0",
  "private": true,
  "theia": {
    "target": "browser-only",
    "frontend": {
      "config": {
        "applicationName": "P5 contributions",
        "preferences": {
          "security.workspace.trust.enabled": false
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter @theia-shell/p5-extension build && theia build --mode development",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@theia-shell/p3-extension": "workspace:*",
    "@theia-shell/p5-extension": "workspace:*",
    "@theia-shell/theia-files-api": "workspace:*",
    "@theia/core": "catalog:",
    "@theia/editor": "catalog:",
    "@theia/filesystem": "catalog:",
    "@theia/messages": "catalog:",
    "@theia/monaco": "catalog:",
    "@theia/navigator": "catalog:",
    "@theia/preferences": "catalog:",
    "@theia/workspace": "catalog:"
  },
  "devDependencies": {
    "@theia/cli": "catalog:"
  }
}
