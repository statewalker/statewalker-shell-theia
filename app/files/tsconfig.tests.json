{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The build config roots at `src` to shape `lib`. This one only typechecks, so it widens
    // the root to take `tests` in as well.
    "rootDir": ".",
    "noEmit": true,
    "types": ["react", "node"]
  },
  "include": ["src", "tests"]
}
