{
  "name": "@theia-shell/theia-pdf-viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Theia extension: opens .pdf files in an EmbedPDF viewer (PDFium in WebAssembly), fully offline.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-shell-theia.git",
    "directory": "packages/theia-pdf-viewer"
  },
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-shell-theia/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-shell-theia/tree/main/packages/theia-pdf-viewer#readme",
  "main": "lib/common/index.js",
  "types": "lib/common/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "theiaExtensions": [
    {
      "frontend": "lib/browser/pdf-viewer-frontend-module",
      "frontendOnly": "lib/browser/pdf-viewer-frontend-module"
    }
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/snippet": "catalog:",
    "@theia/core": "catalog:",
    "@theia/filesystem": "catalog:"
  }
}
