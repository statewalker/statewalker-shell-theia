{
  "name": "@theia-shell/theia-httpeers-proxy",
  "version": "0.0.0",
  "private": true,
  "description": "Theia extension: expose outside HTTP origins to the httpeers mesh through this browser, with a route table editor and a test console.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-shell-theia.git",
    "directory": "packages/theia-httpeers-proxy"
  },
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-shell-theia/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-shell-theia/tree/main/packages/theia-httpeers-proxy#readme",
  "main": "lib/common/index.js",
  "types": "lib/common/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "theiaExtensions": [
    {
      "frontendOnly": "lib/browser/proxy-frontend-module"
    }
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@statewalker/httpeers-core": "catalog:",
    "@statewalker/httpeers-join": "catalog:",
    "@statewalker/webrun-http-proxy": "catalog:",
