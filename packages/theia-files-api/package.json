{
  "name": "@theia-shell/theia-files-api",
  "version": "0.0.0",
  "private": true,
  "description": "Theia extension: serves a @statewalker/webrun-files FilesApi as the file system of a browser-only Theia app.",
  "main": "lib/common/index.js",
  "types": "lib/common/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "theiaExtensions": [
    {
      "frontendOnly": "lib/browser/files-api-frontend-module"
    }
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@theia/core": "catalog:",
    "@theia/filesystem": "catalog:",
    "@theia/navigator": "catalog:",
    "@theia/workspace": "catalog:"
  },
  "devDependencies": {}
}
