{
  "name": "@theia-shell/theia-files-mounts",
  "version": "0.0.0",
  "private": true,
  "description": "Theia extension: a composite, filterable FilesApi of user-defined mount points over a main storage.",
  "main": "lib/common/index.js",
  "types": "lib/common/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "theiaExtensions": [
    {
      "frontend": "lib/browser/mounts-frontend-module",
      "frontendOnly": "lib/browser/mounts-frontend-module"
    }
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-browser": "catalog:",
    "@statewalker/webrun-files-composite": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@theia-shell/theia-files-api": "workspace:*",
    "@theia-shell/theia-secret-vault": "workspace:*",
    "@theia/core": "catalog:",
    "@theia/filesystem": "catalog:",
    "@theia/navigator": "catalog:",
    "@theia/userstorage": "catalog:",
    "@theia/workspace": "catalog:",
    "jsonc-parser": "catalog:"
  }
}
